# AI Video Interview System - Environment Variables

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/ai-interview
# Or use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/ai-interview

# JWT Secret (generate a random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Deepgram API Key (for speech-to-text)
# Get a free key at https://deepgram.com
DEEPGRAM_API_KEY=

# Google Gemini API Key (for AI evaluation)
# Get a free key at https://ai.google.dev
GEMINI_API_KEY=

# Storage Configuration
# Options: 'local' or 's3'
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./uploads

# AWS S3 / Cloudflare R2 (only if STORAGE_TYPE=s3)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=  # For Cloudflare R2, use: https://<account-id>.r2.cloudflarestorage.com

# Server
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
